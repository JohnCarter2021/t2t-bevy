diff --git a/crates/assets/src/br_zone.gsc.txt b/crates/assets/src/br_zone.gsc.txt
new file mode 100644
index 0000000..4c47122
--- /dev/null
+++ b/crates/assets/src/br_zone.gsc.txt
@@ -0,0 +1,112 @@
+main()
+{
+    if (getdvarint("iw4l_br") != 1)
+        return;
+    thread br_zone_main();
+}
+
+br_zone_main()
+{
+    waittillframeend;
+
+    spawns = getentarray("mp_dm_spawn", "classname");
+    if (!isdefined(spawns) || spawns.size == 0)
+        spawns = getentarray("mp_dm_spawn_start", "classname");
+    if (!isdefined(spawns) || spawns.size == 0)
+        return;
+
+    centre = (0, 0, 0);
+    for (i = 0; i < spawns.size; i++)
+        centre = centre + spawns[i].origin;
+    centre = (centre[0] / spawns.size, centre[1] / spawns.size, centre[2] / spawns.size);
+
+    start_radius = 0;
+    for (i = 0; i < spawns.size; i++)
+    {
+        d = distance2d(spawns[i].origin, centre);
+        if (d > start_radius)
+            start_radius = d;
+    }
+    start_radius = start_radius + 512;
+    if (start_radius < 1024)
+        start_radius = 1024;
+
+    level.br_centre = centre;
+    level.br_radius = start_radius;
+    level.br_started = false;
+
+    level waittill("prematch_over");
+    iprintlnbold("Battle Royale: zone starts shrinking in 60 seconds");
+
+    waits = [];
+    fracs = [];
+    waits[0] = 60; fracs[0] = 0.70;
+    waits[1] = 45; fracs[1] = 0.50;
+    waits[2] = 45; fracs[2] = 0.35;
+    waits[3] = 30; fracs[3] = 0.22;
+    waits[4] = 30; fracs[4] = 0.12;
+    waits[5] = 20; fracs[5] = 0.05;
+
+    thread br_zone_damage();
+    thread br_zone_winner();
+
+    for (p = 0; p < waits.size; p++)
+    {
+        wait waits[p];
+        level.br_radius = start_radius * fracs[p];
+        level.br_started = true;
+        iprintlnbold("The zone has shrunk");
+    }
+}
+
+br_zone_damage()
+{
+    for (;;)
+    {
+        wait 1;
+        if (!isdefined(level.br_started) || !level.br_started)
+            continue;
+        if (!isdefined(level.players))
+            continue;
+        for (i = 0; i < level.players.size; i++)
+        {
+            player = level.players[i];
+            if (!isdefined(player) || !isalive(player))
+                continue;
+            if (distance2d(player.origin, level.br_centre) > level.br_radius)
+                player dodamage(5, player.origin);
+        }
+    }
+}
+
+br_zone_winner()
+{
+    announced = false;
+    for (;;)
+    {
+        wait 2;
+        if (announced)
+            return;
+        if (!isdefined(level.players) || level.players.size < 2)
+            continue;
+        alive = 0;
+        winner = undefined;
+        for (i = 0; i < level.players.size; i++)
+        {
+            player = level.players[i];
+            if (isdefined(player) && isalive(player))
+            {
+                alive++;
+                winner = player;
+            }
+        }
+        if (alive == 1 && isdefined(winner))
+        {
+            announced = true;
+            if (isdefined(winner.name))
+                iprintlnbold(winner.name + " wins the Battle Royale");
+            else
+                iprintlnbold("Battle Royale: we have a winner");
+        }
+    }
+}
